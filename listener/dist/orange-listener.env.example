# Copy to ~/.config/orange-listener/orange-listener.env and chmod 600.
# This file holds PATHS only; secrets live in the files it points to.

# Orange identity secret: JSON exactly as Orange stores "ramp.air.identity". chmod 600.
ORANGE_IDENTITY_FILE=<PATH_TO_IDENTITY_JSON>

# Listener's own persisted cursors (catalog.bin, watermark.json). Created mode 700/600.
STATE_DIR=<PATH_TO_STATE_DIR>

# Optional first-run seed of the Air catalog cursors (postcard air::Air; contains the secret too). chmod 600.
# SEED_STATE_FILE=<PATH_TO_SEED_FILE>

# Separate chmod-600 file holding AIR_WAKE_URL and AIR_WAKE_KEY (see wake.env.example).
WAKE_ENV_FILE=<PATH_TO_WAKE_ENV>
