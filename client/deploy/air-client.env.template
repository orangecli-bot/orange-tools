# air-client config for ONE subject. Mode 600, owner = the subject. Paths only: NO secrets in this file.
# Replace __USER__ (the subject's Linux user) and __DIR__ (the directory where the subject's kiwi-daemon ran,
# i.e. the dir holding unread.jsonl / read.jsonl / contacts.json / kiwi_seen.json / notify.env).
# To find __DIR__ as an admin: `sudo systemctl --user -M __USER__@ show kiwi-daemon -p WorkingDirectory --value`.
# New subjects that never ran kiwi can use any private directory, e.g. /home/__USER__/.local/share/air-client.

# Identity: plain secret JSON (mode 600), e.g. copied out of the kiwi data dir. A kiwi state.json also works directly.
AIR_IDENTITY_FILE=/home/__USER__/.config/air-client/identity.json
# Private state (catalog, room cursors, CLI cache, send receipts). Mode 700, created on first run.
AIR_STATE_DIR=/home/__USER__/.local/state/air-client

# Same files the kiwi-era air_unread.sh used, so pending unread lines carry over.
AIR_UNREAD_FILE=__DIR__/unread.jsonl
AIR_READ_FILE=__DIR__/read.jsonl
# Optional: label lookup for the `from` field (kiwi_daemon.sh used the same contacts.json).
AIR_CONTACTS_FILE=__DIR__/contacts.json

# Optional wake. Points at the subject's notify.env (AIR_WAKE_URL / AIR_WAKE_KEY, mode 600).
# Delete or comment out this line for subjects without wake: the listener still records unread messages.
AIR_NOTIFY_ENV=__DIR__/notify.env
# kiwi = {"event":"air_message","count":N,"messages":[{"sender","room","timestamp"}]} (default); orange = one orange_message per message
AIR_WAKE_FORMAT=kiwi
AIR_WAKE_BATCH_MS=1500

# Migration (first start only): skip what kiwi already delivered, deliver what arrived since kiwi stopped.
# AIR_IMPORT_SEEN: kiwi_daemon's kiwi_seen.json (message ids kiwi already handled). Comment out if the file doesn't exist.
AIR_IMPORT_SEEN=__DIR__/kiwi_seen.json
# Messages at or before this time (ns since epoch) are never delivered. Set it to about 10 min before kiwi stopped.
# Don't use systemctl's InactiveEnterTimestamp (it can be empty); see INSTALL.md step 1 (newest of the state.json mtime /
# last kiwi journal line). Manual form: $(( ($(date -d '<TIME_KIWI_STOPPED>' +%s) - 600) * 1000000000 ))
AIR_START_AFTER_NS=
